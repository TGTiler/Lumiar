{
  "expo": {
    "name": "Lumiar Store",
    "slug": "lumiar-store",
    "owner": "tilerfps",
    "version": "1.2.7",
    "scheme": "lumiarstore",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tgtiler.lumiar"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8A2BE2"
      },
      "package": "com.tgtiler.lumiar",
      "versionCode": 18,
      "reactNativeArchitectures": ["armeabi-v7a", "arm64-v8a"],
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "ce2a905c-6f58-4263-b4f8-2cf9fa451744"
      }
    }
  }
}
